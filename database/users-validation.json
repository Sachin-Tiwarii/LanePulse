{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["name", "email", "password_hash"],
    "properties": {
      "name": { "bsonType": "string" },
      "email": { "bsonType": "string" },
      "password_hash": { "bsonType": "string" },
      "role": { "enum": ["admin", "operator"] },
      "created_at": { "bsonType": "date" }
    }
  }
}
