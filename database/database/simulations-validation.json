{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["session_id", "user_id", "start", "end", "status"],
    "properties": {
      "session_id": { "bsonType": "string" },
      "user_id": { "bsonType": "objectId" },
      "start": {
        "bsonType": "object",
        "required": ["lat", "lon"],
        "properties": {
          "lat": { "bsonType": "double" },
          "lon": { "bsonType": "double" }
        }
      },
      "end": {
        "bsonType": "object",
        "required": ["lat", "lon"],
        "properties": {
          "lat": { "bsonType": "double" },
          "lon": { "bsonType": "double" }
        }
      },
      "status": { "enum": ["running", "completed", "failed"] },
      "distance_km": { "bsonType": "number" },
      "duration_min": { "bsonType": "number" },
      "created_at": { "bsonType": "date" },
      "intersections": {
        "bsonType": "array",
        "items": {
          "bsonType": "object",
          "required": ["order", "lat", "lon", "crossed"],
          "properties": {
            "order": { "bsonType": "number" },
            "name": { "bsonType": "string" },
            "lat": { "bsonType": "number" },
            "lon": { "bsonType": "number" },
            "vehicle_count": { "bsonType": "number" },
            "traffic_level": { "enum": ["low", "medium", "high"] },
            "crossed": { "bsonType": "bool" },
            "signal": {
              "bsonType": "object",
              "properties": {
                "green_duration_sec": { "bsonType": "number" },
                "green_started_at": { "bsonType": "date" },
                "released_at": { "bsonType": "date" }
              }
            }
          }
        }
      }
    }
  }
}
